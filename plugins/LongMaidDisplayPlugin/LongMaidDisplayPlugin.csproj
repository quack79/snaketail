<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LongMaidDisplayPlugin</AssemblyName>
    <RootNamespace>LongMaidDisplayPlugin</RootNamespace>
    <!-- Disable the target framework suffix to keep the plugin output directory stable -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Exclude legacy local obj/bin to avoid compiling twice after the move to .temp -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SnakeTail.csproj" />
  </ItemGroup>
</Project>
